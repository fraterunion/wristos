  @@unique([tenantId, fileId, extractionVersion, chunkIndex])
  @@index([tenantId, sessionId])
  @@index([tenantId, fileId, status])
  @@index([tenantId, fileId, extractionVersion, startPage, endPage])
  @@map("document_extraction_chunks")
}

model DataImportRecord {

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum WatchOwnershipType {
  OWNED
  CONSIGNMENT
}

enum WatchStatus {
  AVAILABLE
  RESERVED
  SOLD
  IN_TRANSIT
  IN_SERVICE
}

enum DealStage {
  LEAD
  INTERESTED
  NEGOTIATING
  PENDING_PAYMENT
  CLOSED_WON
  CLOSED_LOST
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentMethod {
  TRANSFER
  CASH
  CARD
  OTHER
  BANCOS
  CESAR
  /// Account-to-account compensation (no Treasury movement).
  SETTLEMENT
}

enum CapitalAccount {
  CASH
  BANK
  CESAR_ACCOUNT
}

enum ClientInteractionType {
  CALL
  MESSAGE
  MEETING
  NOTE
}

enum AutomationRuleType {
  STALE_DEAL
  OVERDUE_PAYMENT
  AGING_INVENTORY
}

enum AutomationRunStatus {
  SUCCESS
  ERROR
}

enum WatchExpenseCategory {
  POLISHING
  REPAIR
  LINKS
  SHIPPING
  PARTS
  COMMISSIONS
  TRAVEL
}

enum OperatingExpenseCategory {
  GASOLINE
  TOLLS
  WATCHMAKER
  PARKING
  MEALS
  FLIGHTS
  TRAVEL
  MARKETING
  COMMISSIONS
  BANK_FEES
  OTHER
}

// --- Cuentas (AR/AP) ---

enum AccountEntryType {
  RECEIVABLE
  PAYABLE
}

enum AccountEntryStatus {
  OPEN
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum AccountEntryCategory {
  SALE_BALANCE
  PURCHASE
  SERVICE
  COMMISSION
  REFUND
  LOAN
  OTHER
}

enum CounterpartyType {
  CLIENT
  SUPPLIER
  DEALER
  BROKER
  WORKSHOP
  LOGISTICS
  OTHER
}

enum Currency {
  MXN
  USD
}

/// Digital / alternative asset class. V1 only supports CRYPTO.
enum AssetType {
  CRYPTO
}

enum TreasuryAccount {
  CASH
  BANK
  CESAR
}

enum TreasuryDirection {
  INFLOW
  OUTFLOW
}

enum AccountEntrySource {
  MANUAL
  DEAL_AUTO
  /// Auto-created PAYABLE from canonical inventory purchase registration (CREDIT / PARTIAL).
  PURCHASE_AUTO
}

// --- Accounts Receivable ledger (Sprint 2) ---

enum ReceivableStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  WRITTEN_OFF
}

enum ReceivablePaymentMethod {
  WIRE
  BANK_TRANSFER
  CASH
  CHECK
  CRYPTO
  CARD
  OTHER
}

enum FinancialAuditEventType {
  RECEIVABLE_CREATED
  PAYMENT_CREATED
  PAYMENT_DELETED
  PAYMENT_REVERSED
  RECEIVABLE_WRITTEN_OFF
}

enum StorefrontReservationStatus {
  PENDING // Stripe session created, awaiting payment
  PAID // checkout.session.completed webhook received
  CANCELLED // session expired or explicitly cancelled
  PROCESSED // admin reviewed and converted to deal
}

enum DataImportStatus {
  CREATED
  UPLOADING
  PROCESSING
  READY_FOR_REVIEW
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

enum DataImportFileStatus {
  UPLOADED
  PROCESSING
  PARSED
  FAILED
}

enum DataImportFileType {
  PDF
  XLSX
  CSV
  JSON
}

enum DataImportEntityType {
  INVENTORY
  SALES
  CLIENTS
  DEALS
  PAYMENTS
  EXPENSES
  ACCOUNTS
  TREASURY
  INVESTORS
  RADAR
  UNKNOWN
}

enum DataImportTarget {
  INVENTORY
  SALES
}

enum DocumentExtractionChunkStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SUPERSEDED
}

enum DataImportRecordStatus {
  STAGED
  SELECTED
  SKIPPED
  IMPORTED
  FAILED
}

enum DataImportDuplicateStatus {
  NONE
  POSSIBLE_DUPLICATE
  CONFIRMED_DUPLICATE
}

enum DataImportEventType {
  SESSION_CREATED
  FILE_UPLOADED
  FILE_PROCESSING
  FILE_PARSED
  FILE_FAILED
  PROCESSING_STARTED
  PROCESSING_COMPLETED
  SESSION_FAILED
  SESSION_CANCELLED
  MAPPING_SAVED
  DRY_RUN_COMPLETED
  IMPORT_STARTED
  IMPORT_COMPLETED
  IMPORT_FAILED
  DOCUMENT_EXTRACTION_STARTED
  DOCUMENT_EXTRACTION_COMPLETED
  DOCUMENT_EXTRACTION_FAILED
  DOCUMENT_EXTRACTION_EDITED
  SALES_EXTRACTION_STARTED
  SALES_EXTRACTION_COMPLETED
  SALES_EXTRACTION_FAILED
  SALES_EXTRACTION_EDITED
  SALES_DRY_RUN_COMPLETED
  SALES_IMPORT_COMMITTED
}

// --- AI Market Radar ---

enum ChannelType {
  TELEGRAM
  WHATSAPP
  DISCORD
  SLACK
  EMAIL
  RSS
  OTHER
}

enum ImportStatus {
  PENDING
  PARSING
  CLASSIFYING
  COMPLETED
  FAILED
  PARTIAL
}

enum MarketListingIntent {
  SELL_OFFER
  BUY_REQUEST
  PRICE_SIGNAL
  GENERAL_INQUIRY
}

enum ReviewStatus {
  PENDING_REVIEW
  CONFIRMED
  DISMISSED
}

enum CatalogDataSource {
  MANUFACTURER_SPEC
  AFTERMARKET_GUIDE
  COMMUNITY_WIKI
  DEALER_NOTE
  AI_EXTRACTION
  MANUAL_ENTRY
}

enum ExtractionSource {
  EXPLICIT
  INFERRED
}

enum ClassificationStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED_PREFILTER
  SKIPPED_MEDIA
  SKIPPED_SYSTEM
}

enum AIConversationSurface {
  MOBILE
  DESKTOP
  API
  WHATSAPP
  VOICE
}

enum AIConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AIActionRunStatus {
  DRAFT
  NEEDS_CLARIFICATION
  READY_FOR_CONFIRMATION
  EXECUTING
  COMPLETED
  FAILED
  CANCELLED
  STALE
}

enum AIInteractionState {
  IDLE
  COLLECTING_INPUT
  AWAITING_CONFIRMATION
  AWAITING_RESPONSE
}

enum AIRequestStatus {
  RECEIVED
  VALIDATING
  PLANNING
  NEEDS_CLARIFICATION
  READY_FOR_CONFIRMATION
  EXECUTING
  COMPLETED
  FAILED
}

enum AIAuditEventType {
  CONVERSATION_CREATED
  CONVERSATION_DELETED
  MESSAGE_APPENDED
  PLAN_CREATED
  PLAN_NEEDS_CLARIFICATION
  PLAN_READY_FOR_CONFIRMATION
  PLAN_CONFIRMED
  EXECUTION_STARTED
  EXECUTION_COMPLETED
  EXECUTION_CANCELLED
  EXECUTION_FAILED
  PLAN_MARKED_STALE
  WORKSPACE_CREATED
  WORKSPACE_UPDATED
  WORKSPACE_RESET
  WORKSPACE_DELETED
  TOOL_EXECUTION_STARTED
  TOOL_EXECUTION_COMPLETED
  TOOL_EXECUTION_FAILED
  TOOL_PERMISSION_DENIED
  TOOL_INPUT_INVALID
  TOOL_OUTPUT_INVALID
  ASSISTANT_REQUEST_RECEIVED
  ASSISTANT_REQUEST_STARTED
  ASSISTANT_REQUEST_REPLAYED
  ASSISTANT_REQUEST_CONFLICTED
  ASSISTANT_REQUEST_COMPLETED
  ASSISTANT_REQUEST_FAILED
}

// --- Core (platform) ---

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  roles                          Role[]
  tenantUsers                    TenantUser[]
  clients                        Client[]
  clientPreferences              ClientPreference[]
  clientInteractions             ClientInteraction[]
  watches                        Watch[]
  watchImages                    WatchImage[]
  watchExpenses                  WatchExpense[]
  operatingExpenses              OperatingExpense[]
  deals                          Deal[]
  payments                       Payment[]
  automationRules                AutomationRule[]
  automationRuns                 AutomationRun[]
  matchSuggestions               MatchSuggestion[]
  channels                       Channel[]
  radarImports                   RadarImport[]
  channelMessages                ChannelMessage[]
  contacts                       Contact[]
  marketListings                 MarketListing[]
  investors                      Investor[]
  investorContributions          InvestorContribution[]
  investorDistributions          InvestorDistribution[]
  investorOpeningBalances        InvestorOpeningBalance[]
  accountEntries                 AccountEntry[]
  accountPayments                AccountPayment[]
  accountSettlements             AccountSettlement[]
  treasuryEntries                TreasuryEntry[]
  physicalCashBalanceAdjustments PhysicalCashBalanceAdjustment[]
  storefrontReservations         StorefrontReservation[]
  dataImportSessions             DataImportSession[]
  dataImportFiles                DataImportFile[]
  dataImportRecords              DataImportRecord[]
  dataImportEvents               DataImportEvent[]
  documentExtractionChunks       DocumentExtractionChunk[]
  receivables                    Receivable[]
  receivablePayments             ReceivablePayment[]
  financialAuditEvents           FinancialAuditEvent[]
  wristCaviarMigrationAnalyses   WristCaviarMigrationAnalysis[]
  assetHoldings                  AssetHolding[]
  assetPriceSnapshots            AssetPriceSnapshot[]
  aiConversations                AIConversation[]
  aiRequests                     AIRequest[]
  aiActionRuns                   AIActionRun[]
  aiAuditEvents                  AIAuditEvent[]
  aiWorkspaces                   AIWorkspace[]

  @@index([slug])
  @@map("tenants")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  displayName  String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenantUsers                         TenantUser[]
  dataImportSessions                  DataImportSession[]                   @relation("DataImportCreatedBy")
  receivablePaymentsCreated           ReceivablePayment[]                   @relation("ReceivablePaymentCreatedBy")
  financialAuditEvents                FinancialAuditEvent[]                 @relation("FinancialAuditActor")
  wristCaviarMigrationAnalyses        WristCaviarMigrationAnalysis[]        @relation("WristCaviarMigrationCreatedBy")
  wristCaviarMigrationResolutions     WristCaviarMigrationResolution[]      @relation("WristCaviarMigrationResolvedBy")
  wristCaviarMigrationEntityApprovals WristCaviarMigrationEntityApproval[]  @relation("WristCaviarMigrationEntityApprovedBy")
  wristCaviarMigrationDatasets        WristCaviarMigrationReviewedDataset[] @relation("WristCaviarMigrationDatasetFrozenBy")
  assetPriceSnapshotsCreated          AssetPriceSnapshot[]                  @relation("AssetPriceSnapshotCreatedBy")
  accountSettlementsCreated           AccountSettlement[]                   @relation("AccountSettlementCreatedBy")
  aiConversations                     AIConversation[]                      @relation("AIConversationUser")
  aiActionRuns                        AIActionRun[]                         @relation("AIActionRunActor")
  aiAuditEvents                       AIAuditEvent[]                        @relation("AIAuditActor")
  aiWorkspaces                        AIWorkspace[]                         @relation("AIWorkspaceUser")
  aiActionRunsConfirmed               AIActionRun[]                         @relation("AIActionRunConfirmedBy")
  aiRequests                          AIRequest[]                           @relation("AIRequestActor")

  @@map("users")
}

// --- WristOS AI runtime foundation ---

model AIConversation {
  id             String                @id @default(cuid())
  tenantId       String
  userId         String
  title          String?
  surface        AIConversationSurface
  status         AIConversationStatus  @default(ACTIVE)
  lastActivityAt DateTime              @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User           @relation("AIConversationUser", fields: [userId], references: [id], onDelete: Restrict)
  messages    AIMessage[]
  actionRuns  AIActionRun[]
  auditEvents AIAuditEvent[]
  workspaces  AIWorkspace[]
  requests    AIRequest[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, userId, lastActivityAt])
  @@map("ai_conversations")
}

model AIMessage {
  id                String        @id @default(cuid())
  conversationId    String
  role              AIMessageRole
  content           String        @db.Text
  structuredPayload Json?
  metadata          Json?
  tokenCount        Int?
  createdAt         DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AIActionRun {
  id                   String            @id @default(cuid())
  conversationId       String
  tenantId             String
  actorUserId          String
  intent               String
  status               AIActionRunStatus @default(DRAFT)
  planFingerprint      String
  idempotencyKey       String
  proposedPlan         Json
  resolvedEntities     Json?
  warnings             Json?
  requiresConfirmation Boolean           @default(true)
  confirmedAt          DateTime?
  confirmedByUserId    String?
  executedAt           DateTime?
  completedAt          DateTime?
  error                String?           @db.Text
  result               Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  conversation     AIConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor            User           @relation("AIActionRunActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  confirmedBy      User?          @relation("AIActionRunConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  auditEvents      AIAuditEvent[]
  activeWorkspaces AIWorkspace[]
  requests         AIRequest[]

  @@index([tenantId, conversationId])
  @@index([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([confirmedByUserId])
  @@map("ai_action_runs")
}

model AIAuditEvent {
  id             String           @id @default(cuid())
  tenantId       String
  actorUserId    String
  conversationId String?
  actionRunId    String?
  workspaceId    String?
  type           AIAuditEventType
  payload        Json?
  createdAt      DateTime         @default(now())

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor        User            @relation("AIAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  actionRun    AIActionRun?    @relation(fields: [actionRunId], references: [id], onDelete: Restrict)
  workspace    AIWorkspace?    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, actionRunId, createdAt])
  @@index([tenantId, workspaceId, createdAt])
  @@map("ai_audit_events")
}

model AIWorkspace {
  id                String                @id @default(cuid())
  tenantId          String
  userId            String
  conversationId    String?
  activeActionRunId String?
  surface           AIConversationSurface
  interactionState  AIInteractionState    @default(IDLE)
  draftPayload      Json?
  resolvedContext   Json?
  selectedEntities  Json?
  pendingResponse   Json?
  version           Int                   @default(1)
  lastActivityAt    DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User            @relation("AIWorkspaceUser", fields: [userId], references: [id], onDelete: Restrict)
  conversation    AIConversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  activeActionRun AIActionRun?    @relation(fields: [activeActionRunId], references: [id], onDelete: Restrict)
  auditEvents     AIAuditEvent[]
  requests        AIRequest[]

  @@index([tenantId, userId, deletedAt])
  @@index([tenantId, userId, surface, lastActivityAt])
  @@index([conversationId])
  @@index([activeActionRunId])
  @@map("ai_workspaces")
}

model AIRequest {
  id                 String          @id @default(cuid())
  tenantId           String
  actorUserId        String
  conversationId     String?
  workspaceId        String?
  actionRunId        String?
  clientRequestId    String
  requestFingerprint String
  status             AIRequestStatus @default(RECEIVED)
  requestPayload     Json
  responsePayload    Json?
  responseHash       String?
  traceId            String
  errorType           String?
  failureSummary     String?
  receivedAt         DateTime        @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor        User            @relation("AIRequestActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  workspace    AIWorkspace?    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actionRun    AIActionRun?    @relation(fields: [actionRunId], references: [id], onDelete: Restrict)

  @@unique([tenantId, actorUserId, clientRequestId])
  @@index([tenantId, actorUserId, createdAt])
  @@index([conversationId])
  @@index([workspaceId])
  @@index([actionRunId])
  @@index([status])
  @@index([requestFingerprint])
  @@map("ai_requests")
}

/// Role names are unique per tenant (e.g. OWNER, SALES, VIEWER).
model Role {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantUsers TenantUser[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_users")
}

// --- WristOS domain (all tenant-scoped) ---

model Client {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  email       String?
  phone       String?
  notes       String?
  tags        String[]
  budgetRange String?
  /// Durable client registration idempotency. Future AI: `ai-action-run:<actionRunId>`.
  registerIdempotencyKey String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals                  Deal[]
  preferences            ClientPreference[]
  matchSuggestions       MatchSuggestion[]
  interactions           ClientInteraction[]
  radarContacts          Contact[]
  accountEntries         AccountEntry[]
  storefrontReservations StorefrontReservation[]
  receivables            Receivable[]
  watchesSold            Watch[]                 @relation("WatchSellerClient")

  @@unique([tenantId, registerIdempotencyKey])
  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, deletedAt])
  /// Active identity uniqueness (email/phone) is enforced by partial expression
  /// indexes in migration 20260809180000_client_register_idempotency:
  ///   clients_tenantId_email_active_key
  ///   clients_tenantId_phone_identity_active_key
  /// Soft-deleted rows are excluded; app still blocks CLIENT_DELETED_MATCH.
  @@map("clients")
}

model ClientPreference {
  id              String   @id @default(cuid())
  tenantId        String
  clientId        String
  preferredBrands String[]
  preferredModels String[]
  budgetMin       Decimal? @db.Decimal(12, 2)
  budgetMax       Decimal? @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId])
  @@index([tenantId])
  @@index([tenantId, clientId])
  @@map("client_preferences")
}

model ClientInteraction {
  id         String                @id @default(cuid())
  tenantId   String
  clientId   String
  type       ClientInteractionType
  notes      String
  occurredAt DateTime
  createdAt  DateTime              @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([tenantId, occurredAt])
  @@map("client_interactions")
}

model Watch {
  id                         String             @id @default(cuid())
  tenantId                   String
  // Partial inventory import may leave identity/commercial fields null when
  // the source document does not provide them (PDF importer).
  brand                      String?
  model                      String?
  reference                  String?
  serialNumber               String?
  imageUrl                   String?
  condition                  String?
  cost                       Decimal?           @db.Decimal(12, 2)
  priceMin                   Decimal?           @db.Decimal(12, 2)
  priceMax                   Decimal?           @db.Decimal(12, 2)
  ownershipType              WatchOwnershipType @default(OWNED)
  consignmentOwnerName       String?
  consignmentSplitPercentage Decimal?           @db.Decimal(5, 2)
  costCurrency               String?
  costOriginalAmount         Decimal?           @db.Decimal(12, 2)
  costExchangeRate           Decimal?           @db.Decimal(12, 6)
  status                     WatchStatus        @default(AVAILABLE)
  isPublished                Boolean            @default(false)
  publicSlug                 String?
  publicDescription          String?            @db.Text
  publicPrice                Decimal?           @db.Decimal(12, 2)
  reservationAmount          Decimal?           @db.Decimal(12, 2)
  /// Canonical acquisition / purchase date. Prefer over createdAt for age & reporting.
  acquiredAt                 DateTime?
  /// Optional seller represented as CRM Client. Does not auto-create clients.
  sellerClientId             String?
  /// Durable purchase registration idempotency. Future AI: `ai-action-run:<actionRunId>`.
  registerIdempotencyKey     String?
  deletedAt                  DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerClient           Client?                 @relation("WatchSellerClient", fields: [sellerClientId], references: [id], onDelete: SetNull)
  deals                  Deal[]
  expenses               WatchExpense[]
  images                 WatchImage[]
  matchSuggestions       MatchSuggestion[]
  accountEntries         AccountEntry[]
  storefrontReservations StorefrontReservation[]

  @@unique([tenantId, publicSlug])
  @@unique([tenantId, registerIdempotencyKey])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, isPublished])
  @@index([tenantId, deletedAt])
  @@index([tenantId, acquiredAt])
  @@index([tenantId, sellerClientId])
  /// Active non-null serial uniqueness is enforced by partial unique index
  /// `watches_tenantId_serialNumber_active_key` in migration SQL
  /// (WHERE serialNumber IS NOT NULL AND deletedAt IS NULL).
  @@map("watches")
}

model WatchImage {
  id        String    @id @default(cuid())
  tenantId  String
  watchId   String
  url       String
  altText   String?
  sortOrder Int       @default(0)
  isPrimary Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  watch  Watch  @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, watchId])
  @@index([tenantId, watchId, sortOrder])
  @@index([tenantId, deletedAt])
  @@map("watch_images")
}

model WatchExpense {
  id        String               @id @default(cuid())
  tenantId  String
  watchId   String
  category  WatchExpenseCategory
  amount    Decimal              @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime             @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  watch  Watch  @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([watchId])
  @@map("watch_expenses")
}

model Deal {
  id                           String    @id @default(cuid())
  tenantId                     String
  clientId                     String
  // Historical sales may omit a linked Watch (nullable). Daily register-sale still requires one.
  watchId                      String?
  stage                        DealStage @default(LEAD)
  expectedCloseAt              DateTime?
  /// Explicit sale/close date (preferred over updatedAt for historical imports).
  soldAt                       DateTime?
  agreedPrice                  Decimal   @db.Decimal(12, 2)
  originalCurrency             String?
  originalAmount               Decimal?  @db.Decimal(12, 2)
  exchangeRate                 Decimal?  @db.Decimal(12, 6)
  notes                        String?
  /// Acquisition cost of the sold item when no Watch is linked (MXN canonical).
  historicalCost               Decimal?  @db.Decimal(12, 2)
  historicalCostCurrency       String?
  historicalCostOriginalAmount Decimal?  @db.Decimal(12, 2)
  historicalCostExchangeRate   Decimal?  @db.Decimal(12, 6)
  extrasAmount                 Decimal?  @db.Decimal(12, 2)
  extrasCurrency               String?
  extrasOriginalAmount         Decimal?  @db.Decimal(12, 2)
  extrasExchangeRate           Decimal?  @db.Decimal(12, 6)
  reportedProfit               Decimal?  @db.Decimal(12, 2)
  calculatedProfit             Decimal?  @db.Decimal(12, 2)
  paymentCount                 Int?
  importSessionId              String?
  importFingerprint            String?
  importSourceRow              Int?
  sourceTag                    String?
  /// Durable sale-registration idempotency key (nullable for legacy / unkeyed manual sales).
  /// Future AI: `ai-action-run:<actionRunId>`. Unique per tenant when non-null.
  registerIdempotencyKey       String?
  deletedAt                    DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client                Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  watch                 Watch?                 @relation(fields: [watchId], references: [id], onDelete: Restrict)
  payments              Payment[]
  operatingExpenses     OperatingExpense[]
  accountEntries        AccountEntry[]
  storefrontReservation StorefrontReservation?
  receivable            Receivable?

  @@unique([tenantId, importFingerprint])
  @@unique([tenantId, registerIdempotencyKey])
  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, clientId])
  @@index([tenantId, watchId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, soldAt])
  @@index([tenantId, importSessionId])
  @@map("deals")
}

model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  dealId    String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  dueDate   DateTime?
  paidAt    DateTime?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal          Deal           @relation(fields: [dealId], references: [id], onDelete: Restrict)
  treasuryEntry TreasuryEntry?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, method])
  @@index([tenantId, dealId])
  @@index([tenantId, deletedAt])
  @@map("payments")
}

/// Deal-originated accounts receivable (1:1 with Deal). Balance is never stored.
model Receivable {
  id               String           @id @default(cuid())
  tenantId         String
  dealId           String           @unique
  customerId       String
  originalAmount   Decimal          @db.Decimal(12, 2)
  currency         Currency         @default(MXN)
  fxRate           Decimal?         @db.Decimal(12, 6)
  /// Canonical MXN amount (originalAmount * fxRate when USD, else originalAmount).
  normalizedAmount Decimal          @db.Decimal(12, 2)
  issueDate        DateTime
  dueDate          DateTime?
  /// Derived status refreshed on payment mutations / reads — not a manual paid flag.
  status           ReceivableStatus @default(PENDING)
  notes            String?
  sourceTag        String?
  writtenOffAt     DateTime?
  writtenOffReason String?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal     Deal                @relation(fields: [dealId], references: [id], onDelete: Restrict)
  customer Client              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments ReceivablePayment[]

  @@unique([tenantId, dealId])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, issueDate])
  @@index([tenantId, dueDate])
  @@index([tenantId, deletedAt])
  @@map("receivables")
}

/// Immutable receivable payment events. Amount is never updated after create.
model ReceivablePayment {
  id                String                  @id @default(cuid())
  tenantId          String
  receivableId      String
  amount            Decimal                 @db.Decimal(12, 2)
  currency          Currency                @default(MXN)
  fxRate            Decimal?                @db.Decimal(12, 6)
  normalizedAmount  Decimal                 @db.Decimal(12, 2)
  paymentDate       DateTime
  method            ReceivablePaymentMethod
  reference         String?
  notes             String?
  createdByUserId   String?
  /// Soft-delete only when no reconciliation exists yet (pre-settlement correction).
  deletedAt         DateTime?
  /// When set, this row is a reversal of another payment.
  reversesPaymentId String?
  createdAt         DateTime                @default(now())

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receivable      Receivable          @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  createdBy       User?               @relation("ReceivablePaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reversesPayment ReceivablePayment?  @relation("ReceivablePaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: Restrict)
  reversedBy      ReceivablePayment[] @relation("ReceivablePaymentReversal")

  @@index([tenantId])
  @@index([tenantId, receivableId])
  @@index([tenantId, paymentDate])
  @@index([tenantId, deletedAt])
  @@map("receivable_payments")
}

model FinancialAuditEvent {
  id           String                  @id @default(cuid())
  tenantId     String
  eventType    FinancialAuditEventType
  entityType   String
  entityId     String
  dealId       String?
  receivableId String?
  actorUserId  String?
  message      String
  metadata     Json?
  createdAt    DateTime                @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("FinancialAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, eventType])
  @@index([tenantId, receivableId])
  @@index([tenantId, entityId])
  @@index([tenantId, createdAt])
  @@map("financial_audit_events")
}

model MatchSuggestion {
  id          String    @id @default(cuid())
  tenantId    String
  clientId    String
  watchId     String
  reason      String
  score       Int
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  watch  Watch  @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId, watchId])
  @@index([tenantId])
  @@index([clientId])
  @@index([watchId])
  @@index([tenantId, dismissedAt])
  @@map("match_suggestions")
}

model AutomationRule {
  id            String             @id @default(cuid())
  tenantId      String
  type          AutomationRuleType
  isEnabled     Boolean            @default(true)
  thresholdDays Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AutomationRun[]

  @@unique([tenantId, type])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, isEnabled])
  @@map("automation_rules")
}

model AutomationRun {
  id           String              @id @default(cuid())
  tenantId     String
  ruleId       String
  status       AutomationRunStatus
  resultCount  Int
  errorMessage String?
  createdAt    DateTime            @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([ruleId])
  @@map("automation_runs")
}

model OperatingExpense {
  id          String                   @id @default(cuid())
  tenantId    String
  dealId      String?
  category    OperatingExpenseCategory
  amount      Decimal                  @db.Decimal(12, 2)
  /// Canonical amount currency. V1 cash-linked registration is MXN-only.
  /// Historical / imported rows default to MXN (no FX backfill).
  currency    Currency                 @default(MXN)
  /// Paid-from treasury source for cash-linked expenses. Null = legacy / import
  /// rows that never wrote a Treasury OUTFLOW (read-only compatibility).
  sourceAccount TreasuryAccount?
  notes       String?
  expenseDate DateTime                 @db.Date
  /// Durable registration idempotency (manual + future AI ActionRun marker).
  /// Example future AI key: `ai-action-run:<actionRunId>`. Nullable; no backfill.
  registerIdempotencyKey String?
  /// Durable reverse causality (Commits 26A/26B). Future AI: `ai-action-run:<actionRunId>`.
  /// Distinguishes AI reverse+crash recovery from independent human reverse.
  /// Nullable; no backfill. Set atomically with deletedAt on reverse.
  reversalIdempotencyKey String?
  deletedAt   DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal           Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  accountEntries AccountEntry[]

  @@unique([tenantId, registerIdempotencyKey])
  @@unique([tenantId, reversalIdempotencyKey])
  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, expenseDate])
  @@index([tenantId, deletedAt])
  @@index([dealId])
  @@map("operating_expenses")
}

// --- AI Market Radar (tenant-scoped ingest + listings) ---

model Channel {
  id                String      @id @default(cuid())
  tenantId          String
  type              ChannelType
  name              String?
  externalChannelId String?
  isActive          Boolean     @default(true)
  metadata          Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  radarImports RadarImport[]
  messages     ChannelMessage[]

  @@unique([tenantId, externalChannelId])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@map("radar_channels")
}

model RadarImport {
  id               String       @id @default(cuid())
  tenantId         String
  channelId        String
  status           ImportStatus @default(PENDING)
  startedAt        DateTime?
  completedAt      DateTime?
  errorMessage     String?
  stats            Json?
  originalFileName String?
  fileSizeBytes    Int?
  sourceGroupName  String?
  dateRangeStart   DateTime?
  dateRangeEnd     DateTime?
  listingsCreated  Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel  Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messages ChannelMessage[]

  @@index([tenantId])
  @@index([tenantId, channelId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("radar_imports")
}

model ChannelMessage {
  id                   String               @id @default(cuid())
  tenantId             String
  channelId            String
  importId             String
  externalMessageId    String?
  content              String               @db.Text
  contentHash          String
  postedAt             DateTime?
  /// Reserved for live-channel ingestion (WhatsApp user ID, Telegram user ID, etc.). For .txt imports, use senderRaw instead. Null during V1.
  authorExternalId     String?
  rawPayload           Json?
  classificationStatus ClassificationStatus @default(PENDING)
  processedAt          DateTime?
  hasMedia             Boolean              @default(false)
  isSystemMessage      Boolean              @default(false)
  senderRaw            String
  createdAt            DateTime             @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  import        RadarImport    @relation(fields: [importId], references: [id], onDelete: Cascade)
  marketListing MarketListing?

  @@unique([tenantId, contentHash])
  @@index([tenantId])
  @@index([tenantId, channelId])
  @@index([tenantId, importId])
  @@index([tenantId, postedAt])
  @@index([tenantId, channelId, postedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, classificationStatus])
  @@map("radar_channel_messages")
}

model Contact {
  id               String    @id @default(cuid())
  tenantId         String
  clientId         String?
  displayName      String?
  phone            String?
  email            String?
  telegramUsername String?
  telegramUserId   String?
  whatsappId       String?
  notes            String?
  metadata         Json?
  firstSeenAt      DateTime?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  marketListings MarketListing[]

  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, telegramUserId])
  @@index([tenantId, createdAt])
  @@map("radar_contacts")
}

model MarketListing {
  id                      String              @id @default(cuid())
  tenantId                String
  messageId               String              @unique
  contactId               String?
  watchReferenceId        String?
  intent                  MarketListingIntent @default(GENERAL_INQUIRY)
  reviewStatus            ReviewStatus        @default(PENDING_REVIEW)
  referenceSource         ExtractionSource?
  brand                   String?
  feedConfidence          Float?
  initialConfidence       Float?
  rawModelMention         String?
  referenceNumberExplicit String?
  aiSummary               String?
  urgencyDetected         Boolean             @default(false)
  conditionNotes          String?
  hasBox                  Boolean?
  hasPapers               Boolean?
  year                    Int?
  dealerNotes             String?
  confirmedBy             String?
  confirmedAt             DateTime?
  dismissedBy             String?
  dismissedAt             DateTime?
  deletedAt               DateTime?
  aiRawResponse           Json?
  title                   String?
  description             String?             @db.Text
  priceAmount             Decimal?            @db.Decimal(14, 2)
  priceCurrency           String?
  location                String?
  metadata                Json?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message        ChannelMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  watchReference WatchReference? @relation(fields: [watchReferenceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, reviewStatus])
  @@index([tenantId, intent])
  @@index([tenantId, watchReferenceId])
  @@index([tenantId, contactId])
  @@index([tenantId, createdAt])
  @@index([tenantId, reviewStatus, createdAt])
  @@index([tenantId, reviewStatus, feedConfidence, createdAt])
  @@index([tenantId, brand, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId, priceAmount, intent])
  @@map("radar_market_listings")
}

/// Global watch reference catalog (not tenant-scoped).
model WatchReference {
  id                   String            @id @default(cuid())
  brand                String
  model                String
  reference            String
  catalogSource        CatalogDataSource @default(MANUAL_ENTRY)
  aliases              Json
  line                 String?
  approximateRetailUsd Decimal?          @db.Decimal(12, 2)
  discontinued         Boolean           @default(false)
  metadata             Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  marketListings MarketListing[]

  @@unique([brand, model, reference])
  @@index([brand])
  @@index([reference])
  @@index([brand, model])
  @@map("radar_watch_references")
}

// --- Capital de socios ---

model Investor {
  id               String    @id @default(cuid())
  tenantId         String
  name             String
  ownershipPercent Decimal   @db.Decimal(5, 2)
  isActive         Boolean   @default(true)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contributions   InvestorContribution[]
  distributions   InvestorDistribution[]
  openingBalances InvestorOpeningBalance[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
  @@map("investors")
}

/// Opening equity position when WristOS begins tracking an already-operating business.
/// Counts toward invested capital / ROI denominator. Does NOT create Treasury movements
/// and is never treated as a current-period cash contribution.
model InvestorOpeningBalance {
  id            String    @id @default(cuid())
  tenantId      String
  investorId    String
  amount        Decimal   @db.Decimal(12, 2)
  currency      Currency  @default(MXN)
  effectiveDate DateTime
  /// Stable idempotency key, e.g. wrist-caviar-opening-capital-2025-07-29
  source        String
  notes         String?
  createdBy     String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investor Investor @relation(fields: [investorId], references: [id], onDelete: Restrict)

  @@unique([tenantId, investorId, source])
  @@index([tenantId])
  @@index([tenantId, investorId])
  @@index([tenantId, effectiveDate])
  @@index([tenantId, deletedAt])
  @@map("investor_opening_balances")
}

model InvestorContribution {
  id            String         @id @default(cuid())
  tenantId      String
  investorId    String
  amount        Decimal        @db.Decimal(12, 2)
  account       CapitalAccount
  notes         String?
  contributedAt DateTime
  /// Durable registration idempotency. Future AI: `ai-action-run:<actionRunId>`.
  /// V1 Capital contribution is partner-ledger only — does NOT write Treasury.
  registerIdempotencyKey String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investor      Investor       @relation(fields: [investorId], references: [id], onDelete: Restrict)
  treasuryEntry TreasuryEntry?

  @@unique([tenantId, registerIdempotencyKey])
  @@index([tenantId])
  @@index([tenantId, investorId])
  @@index([tenantId, contributedAt])
  @@index([tenantId, deletedAt])
  @@map("investor_contributions")
}

model InvestorDistribution {
  id         String         @id @default(cuid())
  tenantId   String
  investorId String
  amount     Decimal        @db.Decimal(12, 2)
  account    CapitalAccount
  notes      String?
  paidAt     DateTime
  /// Durable registration idempotency. Future AI: `ai-action-run:<actionRunId>`.
  /// V1 Capital distribution is partner-ledger only — does NOT write Treasury.
  registerIdempotencyKey String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investor      Investor       @relation(fields: [investorId], references: [id], onDelete: Restrict)
  treasuryEntry TreasuryEntry?

  @@unique([tenantId, registerIdempotencyKey])
  @@index([tenantId])
  @@index([tenantId, investorId])
  @@index([tenantId, paidAt])
  @@index([tenantId, deletedAt])
  @@map("investor_distributions")
}

// --- Treasury (cash ledger) ---

model TreasuryEntry {
  id              String            @id @default(cuid())
  tenantId        String
  account         TreasuryAccount
  direction       TreasuryDirection
  amount          Decimal           @db.Decimal(12, 2)
  currency        Currency
  amountMxn       Decimal           @db.Decimal(12, 2)
  exchangeRate    Decimal?          @db.Decimal(12, 6)
  /// Bank commission component (CONTROL BANCOS). Nullable — not defaulted to 0.
  /// Distinct from amount/amountMxn (movement totals). Populated for migrated BANK rows
  /// and for sale bank-fee OUTFLOW rows (amountMxn embeds the cash effect; commission is P&L).
  commission      Decimal?          @db.Decimal(12, 2)
  transactionDate DateTime
  description     String?

  accountPaymentId String? @unique
  /// Optional 1:1 link to the gross deal Payment INFLOW only (fee OUTFLOW uses provenanceKey).
  dealPaymentId    String? @unique
  contributionId   String? @unique
  distributionId   String? @unique
  /// Durable movement provenance for idempotent multi-leg writes, e.g.
  /// `deal-payment:<paymentId>:inflow` | `deal-payment:<paymentId>:bank-fee`.
  /// Nullable for legacy / non-keyed rows. Unique per tenant when set.
  provenanceKey    String?

  /// Durable reverse causality (Commits 26A/26B). Future AI: `ai-action-run:<actionRunId>`.
  /// Transfer reverses stamp BOTH legs with the same key; uniqueness is per direction.
  /// Expense OUTFLOW may also carry the OpEx reverse key. Nullable; no backfill.
  reversalIdempotencyKey String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant                        Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountPayment                AccountPayment?                @relation(fields: [accountPaymentId], references: [id], onDelete: SetNull)
  dealPayment                   Payment?                       @relation(fields: [dealPaymentId], references: [id], onDelete: SetNull)
  contribution                  InvestorContribution?          @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  distribution                  InvestorDistribution?          @relation(fields: [distributionId], references: [id], onDelete: SetNull)
  physicalCashBalanceAdjustment PhysicalCashBalanceAdjustment?

  @@unique([tenantId, provenanceKey])
  @@unique([tenantId, reversalIdempotencyKey, direction])
  @@index([tenantId])
  @@index([tenantId, account])
  @@index([tenantId, account, direction])
  @@index([tenantId, transactionDate])
  @@index([tenantId, deletedAt])
  @@map("treasury_entries")
}

/// Auditable physical MXN cash balance set (manual count / César correction).
/// Official Dashboard CASH KPI uses the latest row + subsequent MXN CASH movements.
/// USD cash is intentionally excluded from the physical MXN KPI.
model PhysicalCashBalanceAdjustment {
  id               String    @id @default(cuid())
  tenantId         String
  /// Always MXN for physical-cash KPI.
  currency         Currency  @default(MXN)
  previousBalance  Decimal   @db.Decimal(14, 2)
  adjustmentAmount Decimal   @db.Decimal(14, 2)
  resultingBalance Decimal   @db.Decimal(14, 2)
  reason           String
  source           String
  actor            String
  effectiveDate    DateTime
  /// Optional link if a companion treasury row was also written (not required).
  treasuryEntryId  String?   @unique
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  treasuryEntry TreasuryEntry? @relation(fields: [treasuryEntryId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, effectiveDate])
  @@index([tenantId, deletedAt])
  @@map("physical_cash_balance_adjustments")
}

// --- Cuentas (AR/AP) ---

model AccountEntry {
  id               String               @id @default(cuid())
  tenantId         String
  type             AccountEntryType
  status           AccountEntryStatus   @default(OPEN)
  category         AccountEntryCategory @default(OTHER)
  source           AccountEntrySource   @default(MANUAL)
  counterpartyName String
  counterpartyType CounterpartyType     @default(OTHER)
  concept          String
  totalAmount      Decimal              @db.Decimal(12, 2)
  currency         Currency             @default(MXN)
  exchangeRate     Decimal?             @db.Decimal(12, 6)
  reference        String?
  issuedAt         DateTime?
  dueDate          DateTime?
  closedAt         DateTime?
  notes            String?
  /// Durable registration idempotency for MANUAL receivable/payable create.
  /// Not used for DEAL_AUTO / PURCHASE_AUTO legs.
  /// Future AI ActionRun recovery marker: e.g. `ai-action-run:<actionRunId>`.
  registerIdempotencyKey String?

  clientId  String?
  dealId    String?
  watchId   String?
  expenseId String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant                  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client                  Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  deal                    Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  watch                   Watch?              @relation(fields: [watchId], references: [id], onDelete: SetNull)
  expense                 OperatingExpense?   @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  payments                AccountPayment[]
  settlementsAsReceivable AccountSettlement[] @relation("AccountSettlementReceivable")
  settlementsAsPayable    AccountSettlement[] @relation("AccountSettlementPayable")

  @@unique([tenantId, registerIdempotencyKey])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, type, status])
  @@index([tenantId, source])
  @@index([tenantId, dueDate])
  @@index([tenantId, clientId])
  @@index([tenantId, dealId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, createdAt])
  @@map("account_entries")
}

model AccountPayment {
  id               String           @id @default(cuid())
  tenantId         String
  entryId          String
  amount           Decimal          @db.Decimal(12, 2)
  currency         Currency         @default(MXN)
  method           PaymentMethod
  paidAt           DateTime
  notes            String?
  cashAccount      TreasuryAccount?
  exchangeRateUsed Decimal?         @db.Decimal(12, 6)
  /// Durable registration idempotency for received-money payments (CASH/BANK/CESAR).
  /// Not used for APPLY_TO_PAYABLE settlement legs — those use AccountSettlement.idempotencyKey.
  /// Future AI ActionRun recovery marker: e.g. `ai-action-run:<actionRunId>`.
  registerIdempotencyKey String?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant                        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry                         AccountEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  treasuryEntry                 TreasuryEntry?
  settlementAsReceivablePayment AccountSettlement? @relation("AccountSettlementReceivablePayment")
  settlementAsPayablePayment    AccountSettlement? @relation("AccountSettlementPayablePayment")

  @@unique([tenantId, registerIdempotencyKey])
  @@index([tenantId])
  @@index([entryId])
  @@index([tenantId, entryId])
  @@index([tenantId, paidAt])
  @@index([tenantId, deletedAt])
  @@map("account_payments")
}

/// Direct AR↔AP compensation: reduces both outstanding balances without Treasury/liquidity movement.
model AccountSettlement {
  id                  String    @id @default(cuid())
  tenantId            String
  receivableEntryId   String
  payableEntryId      String
  receivablePaymentId String    @unique
  payablePaymentId    String    @unique
  amount              Decimal   @db.Decimal(12, 2)
  currency            Currency
  effectiveDate       DateTime
  notes               String?
  createdByUserId     String?
  /// Optional client-supplied key to make settlement creation idempotent per tenant.
  idempotencyKey      String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receivableEntry   AccountEntry   @relation("AccountSettlementReceivable", fields: [receivableEntryId], references: [id], onDelete: Restrict)
  payableEntry      AccountEntry   @relation("AccountSettlementPayable", fields: [payableEntryId], references: [id], onDelete: Restrict)
  receivablePayment AccountPayment @relation("AccountSettlementReceivablePayment", fields: [receivablePaymentId], references: [id], onDelete: Restrict)
  payablePayment    AccountPayment @relation("AccountSettlementPayablePayment", fields: [payablePaymentId], references: [id], onDelete: Restrict)
  createdBy         User?          @relation("AccountSettlementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, receivableEntryId])
  @@index([tenantId, payableEntryId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, effectiveDate])
  @@map("account_settlements")
}

// --- Storefront ---

model StorefrontReservation {
  id       String  @id @default(cuid())

  chunkIndex        Int     @map("chunk_index")
  startPage         Int     @map("start_page")
  endPage           Int     @map("end_page")
  pageCount         Int     @map("page_count")
  sourceFingerprint String  @map("source_fingerprint")
  chunkFingerprint  String  @map("chunk_fingerprint")
  parentChunkId     String? @map("parent_chunk_id")

  status       DocumentExtractionChunkStatus @default(PENDING)
  attemptCount Int                           @default(0) @map("attempt_count")

  provider          String?
  model             String?
  extractionVersion String  @map("extraction_version")
  stopReason        String? @map("stop_reason")

  rawResult        Json? @map("raw_result")
  normalizedResult Json? @map("normalized_result")

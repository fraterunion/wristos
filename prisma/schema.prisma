model WristCaviarMigrationReviewedDataset {
  id                        String                        @id @default(cuid())
  tenantId                  String                        @map("tenant_id")
  analysisId                String                        @map("analysis_id")
  datasetVersion            String                        @map("dataset_version")
  fingerprint               String
  fingerprintPrefix         String                        @map("fingerprint_prefix")
  parserVersion             String                        @map("parser_version")
  sourceWorkbookFingerprint String                        @map("source_workbook_fingerprint")

// --- Wrist Caviar master workbook migration (analysis / preview only) ---

enum WristCaviarMigrationReadiness {
  READY_FOR_DRY_RUN
  NEEDS_REVIEW
  BLOCKED
}

enum WristCaviarMigrationAnalysisStatus {
  ANALYZING
  COMPLETED
  FAILED
}

model WristCaviarMigrationAnalysis {
  id                    String                             @id @default(cuid())
  tenantId              String                             @map("tenant_id")
  createdByUserId       String                             @map("created_by_user_id")
  status                WristCaviarMigrationAnalysisStatus @default(ANALYZING)
  readiness             WristCaviarMigrationReadiness
  parserVersion         String                             @map("parser_version")
  fingerprint           String
  fingerprintPrefix     String                             @map("fingerprint_prefix")
  fileName              String                             @map("file_name")
  fileSizeBytes         Int                                @map("file_size_bytes")
  durationMs            Int?                               @map("duration_ms")
  sheetSummaries        Json                               @map("sheet_summaries")
  normalizedCounts      Json                               @map("normalized_counts")
  issueSummary          Json                               @map("issue_summary")
  reconciliationSummary Json                               @map("reconciliation_summary")
  /// Private normalized snapshot for paginated preview (platform-admin only). Never public CDN.
  privateSnapshot       Json?                              @map("private_snapshot")
  /// Working reviewed snapshot (original + active overlays). Not frozen.
  reviewedSnapshot      Json?                              @map("reviewed_snapshot")
  /// Optimistic concurrency for review mutations.
  reviewVersion         Int                                @default(0) @map("review_version")
  errorMessage          String?                            @map("error_message")
  createdAt             DateTime                           @default(now()) @map("created_at")
  updatedAt             DateTime                           @updatedAt @map("updated_at")

  tenant          Tenant                                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy       User                                  @relation("WristCaviarMigrationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  issues          WristCaviarMigrationIssue[]
  sheets          WristCaviarMigrationSheet[]
  resolutions     WristCaviarMigrationResolution[]
  entityApprovals WristCaviarMigrationEntityApproval[]
  datasets        WristCaviarMigrationReviewedDataset[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, readiness])
  @@map("wrist_caviar_migration_analyses")
}

model WristCaviarMigrationSheet {
  id                String @id @default(cuid())
  tenantId          String @map("tenant_id")
  analysisId        String @map("analysis_id")
  sheetName         String @map("sheet_name")
  classification    String
  status            String
  detectedRecords   Int    @map("detected_records")
  warningCount      Int    @map("warning_count")
  errorCount        Int    @map("error_count")
  manualReviewCount Int    @map("manual_review_count")
  notes             Json?

  analysis WristCaviarMigrationAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([analysisId])
  @@map("wrist_caviar_migration_sheets")
}

model WristCaviarMigrationIssue {
  id            String  @id @default(cuid())
  tenantId      String  @map("tenant_id")
  analysisId    String  @map("analysis_id")
  code          String
  /// Normalized Phase 1.5 taxonomy code
  taxonomyCode  String? @map("taxonomy_code")
  severity      String
  category      String?
  message       String
  sourceSheet   String? @map("source_sheet")
  sourceRow     Int?    @map("source_row")
  sourceBlockId String? @map("source_block_id")
  entityType    String? @map("entity_type")
  candidateId   String? @map("candidate_id")
  /// UNRESOLVED | RESOLVED | ACKNOWLEDGED | EXCLUDED | DEFERRED
  reviewStatus  String  @default("UNRESOLVED") @map("review_status")

  analysis    WristCaviarMigrationAnalysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  resolutions WristCaviarMigrationResolution[]

  @@index([tenantId])
  @@index([analysisId])
  @@index([analysisId, severity])
  @@index([analysisId, taxonomyCode])
  @@index([analysisId, reviewStatus])
  @@map("wrist_caviar_migration_issues")
}

enum WristCaviarMigrationResolutionType {
  ACCEPT_AS_IS
  CORRECT_VALUE
  MAP_ENTITY
  MERGE_EXACT_DUPLICATE
  KEEP_SEPARATE
  EXCLUDE_FROM_MIGRATION
  DEFER
  CONFIRM_SCOPE_DIFFERENCE
  CONFIRM_FORMULA_OVERRIDE
  ACKNOWLEDGE_WARNING
  CHOOSE_CANONICAL_NAME
  MARK_SERIAL_UNKNOWN
  CONFIRM_INVENTORY_OVERLAP
}

enum WristCaviarMigrationResolutionStatus {
  ACTIVE
  SUPERSEDED
}

model WristCaviarMigrationResolution {
  id               String                               @id @default(cuid())
  tenantId         String                               @map("tenant_id")
  analysisId       String                               @map("analysis_id")
  issueId          String?                              @map("issue_id")
  entityType       String?                              @map("entity_type")
  candidateId      String?                              @map("candidate_id")
  resolutionType   WristCaviarMigrationResolutionType   @map("resolution_type")
  status           WristCaviarMigrationResolutionStatus @default(ACTIVE)
  originalValue    Json?                                @map("original_value")
  resolvedValue    Json?                                @map("resolved_value")
  reason           String?
  notes            String?
  idempotencyKey   String?                              @map("idempotency_key")
  resolvedByUserId String                               @map("resolved_by_user_id")
  resolvedAt       DateTime                             @default(now()) @map("resolved_at")
  createdAt        DateTime                             @default(now()) @map("created_at")
  updatedAt        DateTime                             @updatedAt @map("updated_at")

  analysis   WristCaviarMigrationAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  issue      WristCaviarMigrationIssue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  resolvedBy User                         @relation("WristCaviarMigrationResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@unique([analysisId, idempotencyKey])
  @@index([tenantId, analysisId])
  @@index([analysisId, issueId])
  @@index([analysisId, status])
  @@map("wrist_caviar_migration_resolutions")
}

enum WristCaviarMigrationEntityGroup {
  CUSTOMERS
